  "item": [
    {
      "name": "🔐 OAuth Token",
      "item": [
        {
          "name": "取得 Token (client_credentials)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('access_token', jsonData.access_token);",
                  "    console.log('✅ access_token 已自動儲存');",
                  "    console.log('Token Type: ' + jsonData.token_type);",
                  "    console.log('Expires In: ' + jsonData.expires_in + ' seconds');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "{{client_id}}",
                  "type": "text"
                },
                {
                  "key": "client_secret",
                  "value": "{{client_secret}}",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/newgateway/oauth/token",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "newgateway",
                "oauth",
                "token"
              ]
            },
            "description": "使用 client_credentials 取得 access_token。\n成功後 token 會自動存到 collection variable。"
          },
          "response": []
        },
        {
